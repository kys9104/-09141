rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for user authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Role checks (supports both standard 'admin', 'captain', 'council', 'student' and legacy casing)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'kys9104@ai.jne.kr' ||
        (userExists(request.auth.uid) && (
          getUserDoc(request.auth.uid).role == 'admin' ||
          getUserDoc(request.auth.uid).role == 'TEACHER'
        ))
      );
    }

    function isCaptain() {
      return isAuthenticated() && (
        isAdmin() ||
        (userExists(request.auth.uid) && (
          getUserDoc(request.auth.uid).role == 'captain' ||
          getUserDoc(request.auth.uid).role == 'SPORTS_REP'
        ))
      );
    }

    function isCouncil() {
      return isAuthenticated() && (
        isAdmin() ||
        (userExists(request.auth.uid) && (
          getUserDoc(request.auth.uid).role == 'council' ||
          getUserDoc(request.auth.uid).role == 'STUDENT_COUNCIL'
        ))
      );
    }

    // Users collection:
    // Any student can read to check assigned roles.
    // Writes are allowed for authenticated users, teacher admins, or role assignments.
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Rosters (출전명단) collection:
    // 읽기는 누구나 가능, 쓰기/수정 허용
    match /rosters/{rosterId} {
      allow read: if true;
      allow write: if true;
    }

    // Matches (경기결과) collection:
    // 읽기는 누구나 가능, 점수 및 경기 결과 쓰기/수정 허용
    match /matches/{matchId} {
      allow read: if true;
      allow write: if true;
    }

    // Settings (구글 시트 GAS URL 등 시스템 설정):
    // 읽기는 누구나 가능, 쓰기/수정 허용
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
