rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for user authentication and role verification
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Role checks (supports both standard 'admin', 'captain', 'council', 'student' and legacy casing)
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'kys9104@ai.jne.kr' ||
        (userExists(request.auth.uid) && (
          getUserDoc(request.auth.uid).role == 'admin' ||
          getUserDoc(request.auth.uid).role == 'TEACHER'
        ))
      );
    }

    function isCaptain() {
      return isAuthenticated() && (
        isAdmin() ||
        (userExists(request.auth.uid) && (
          getUserDoc(request.auth.uid).role == 'captain' ||
          getUserDoc(request.auth.uid).role == 'SPORTS_REP'
        ))
      );
    }

    function isCouncil() {
      return isAuthenticated() && (
        isAdmin() ||
        (userExists(request.auth.uid) && (
          getUserDoc(request.auth.uid).role == 'council' ||
          getUserDoc(request.auth.uid).role == 'STUDENT_COUNCIL'
        ))
      );
    }

    // Users collection:
    // Any authenticated student can read; users can create their own profile;
    // Admins (체육교사) can update any user's role (grant/revoke captain role).
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAdmin() || (
        isAuthenticated() && request.auth.uid == userId &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
      );
      allow delete: if isAdmin();
    }

    // Rosters (출전명단) collection:
    // 출전명단(rosters) 쓰기는 체육교사와 '반장/체육부장' 권한을 가진 자만 가능.
    // 읽기는 로그인한 모든 학생이 가능.
    match /rosters/{rosterId} {
      allow read: if isAuthenticated();
      allow create, update: if isCaptain();
      allow delete: if isAdmin();
    }

    // Matches (경기결과) collection:
    // 경기결과 쓰기는 체육교사와 '학생자치회' 권한을 가진 자만 가능.
    // 읽기는 로그인한 모든 학생이 가능.
    match /matches/{matchId} {
      allow read: if isAuthenticated();
      allow create, update: if isCouncil();
      allow delete: if isAdmin();
    }

    // Settings (구글 시트 GAS URL 등 시스템 설정):
    // 체육교사(Admin)만 쓰기 가능, 로그인한 사용자는 읽기 가능.
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
